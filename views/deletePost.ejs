<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chango&family=Cherry+Bomb+One&family=Fascinate+Inline&family=Hachi+Maru+Pop&family=Neucha&family=Ribeye+Marrow&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/main.css" />
    <title>Delete Post</title>
    <link rel="icon" href="/images/matcha-logo.webp"/>
  </head>
  <body>
    <%- include("./partials/header.ejs") %>
    <div class="content">
      <div class="welcome">
            <h1>Delete Post</h1>
                <form action="/deletePost" method="post">
                  <%if(locals.posts){%>
                    <%for(let i=0;i<posts.length;i++){%>
                        <label name="postDelete">
                            <input type="radio" name="postDeleteRadio" value="<%=posts[i].title%>" />
                            <%= posts[i].title %>
                        </label>
                        <br>
                    <%}%>
                    <input type="submit" value="Delete">
                  <%}else{%>
                        <label>There are no posts to delete!</label>
                  <%}%>
                  
                </form>
          </div>
    </div>
    
    
    <%- include("./partials/footer.ejs") %>
  </body>
</html>
