<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mia's Web Blog</title>
    <link rel="icon" href="/images/matcha-logo.webp"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chango&family=Cherry+Bomb+One&family=Fascinate+Inline&family=Hachi+Maru+Pop&family=Neucha&family=Ribeye+Marrow&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/main.css" />
    
  </head>
  <body>
    <%- include("./partials/header.ejs") %> 
    <div class="content">
      <div class="welcome">
        <h1>Welcome!</h1>
        <p>
          Welcome to my web blog! Click on Create Post to start creating your posts
          today!
        </p>
      </div>
      <%if(locals.posts && locals.posts.length!=0){%>
        <div class="all-posts">
          <h1>All Posts</h1>
          <hr />
          <%# This for loop shows all the blogs %>
          <%for(let i=0;i<posts.length;i++){ %>
            <a href="/viewPost/<%=posts[i].title%>">
              <div name="blog<%=i%>" class="post">
                
                  <h3><%= posts[i].title %></h3>
                  <p><%= posts[i].text%></p>
                
              </div>
            </a>
          <% } %>
        </div>
      <%}else{%>
        <h1>No posts!</h1>
      <%}%>
    </div>
    <%- include("./partials/footer.ejs") %>
  </body>
</html>
